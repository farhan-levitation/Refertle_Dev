generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReferralClick {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  referral_code  String?         @db.VarChar(50)
  ipAddress      String?         @map("ip_address") @db.VarChar(45)
  userAgent      String?         @map("user_agent")
  source         String?         @db.VarChar(50)
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  referral_codes referral_codes? @relation(fields: [referral_code], references: [code], onDelete: Cascade, onUpdate: NoAction)

  @@map("referral_clicks")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model campaigns {
  id                       String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  merchant_id              String?                 @db.Uuid
  name                     String                  @db.VarChar(255)
  status                   String?                 @default("draft") @db.VarChar(50)
  start_date               DateTime?               @db.Timestamptz(6)
  end_date                 DateTime?               @db.Timestamptz(6)
  reward_type              String                  @db.VarChar(50)
  who_gets_reward          String                  @db.VarChar(50)
  referrer_reward_type     String?                 @db.VarChar(50)
  referrer_reward_value    Decimal?                @db.Decimal(10, 2)
  referee_reward_type      String?                 @db.VarChar(50)
  referee_reward_value     Decimal?                @db.Decimal(10, 2)
  min_order_value          Decimal?                @default(0) @db.Decimal(10, 2)
  eligible_products        Json?                   @default("[\"all\"]")
  eligible_collections     Json?                   @default("[]")
  usage_limit              String?                 @default("unlimited") @db.VarChar(50)
  reward_issuance          String?                 @default("instant") @db.VarChar(50)
  reward_issuance_days     Int?                    @default(0)
  reward_expiry_days       Int?                    @default(365)
  return_cancellation_rule String?                 @default("revoke") @db.VarChar(50)
  created_at               DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?               @default(now()) @db.Timestamptz(6)
  merchants                merchants?              @relation(fields: [merchant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  referral_codes           referral_codes[]
  referral_transactions    referral_transactions[]
  rewards                  rewards[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model fraud_flags {
  id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  merchant_id   String?    @db.Uuid
  referral_code String?    @db.VarChar(50)
  actor_email   String?    @db.VarChar(255)
  reason        String?    @db.VarChar(255)
  severity      String?    @default("medium") @db.VarChar(20)
  metadata      Json?
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  merchants     merchants? @relation(fields: [merchant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model merchants {
  id                     String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shop_id                String                  @unique @db.VarChar(255)
  shop_domain            String                  @unique @db.VarChar(255)
  email                  String?                 @unique @db.VarChar(255)
  phone                  String?                 @db.VarChar(50)
  access_token_encrypted String?
  plan                   String?                 @default("basic") @db.VarChar(50)
  status                 String?                 @default("active") @db.VarChar(50)
  supabase_user_id       String?                 @db.Uuid
  created_at             DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?               @default(now()) @db.Timestamptz(6)
  name                   String?                 @db.VarChar(255)
  campaigns              campaigns[]
  fraud_flags            fraud_flags[]
  referral_codes         referral_codes[]
  referral_transactions  referral_transactions[]
  referrers              referrers[]
  rewards                rewards[]
  user_points            user_points[]
  user_wallets           user_wallets[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model referral_codes {
  code                  String                  @id @db.VarChar(50)
  merchant_id           String?                 @db.Uuid
  referrer_id           String?                 @db.Uuid
  campaign_id           String?                 @db.Uuid
  product_id            String?                 @db.VarChar(255)
  variant_id            String?                 @db.VarChar(255)
  clicks                Int?                    @default(0)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  referral_clicks       ReferralClick[]
  campaigns             campaigns?              @relation(fields: [campaign_id], references: [id], onUpdate: NoAction)
  merchants             merchants?              @relation(fields: [merchant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  referrers             referrers?              @relation(fields: [referrer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  referral_transactions referral_transactions[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model referral_transactions {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  merchant_id    String?         @db.Uuid
  campaign_id    String?         @db.Uuid
  referral_code  String?         @db.VarChar(50)
  referrer_id    String?         @db.Uuid
  order_id       String          @db.VarChar(255)
  order_number   String?         @db.VarChar(100)
  total_price    Decimal?        @db.Decimal(10, 2)
  currency       String?         @db.VarChar(10)
  customer_email String?         @db.VarChar(255)
  status         String?         @default("pending_validation") @db.VarChar(50)
  fraud_reason   String?
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?       @default(now()) @db.Timestamptz(6)
  campaigns      campaigns?      @relation(fields: [campaign_id], references: [id], onUpdate: NoAction)
  merchants      merchants?      @relation(fields: [merchant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  referral_codes referral_codes? @relation(fields: [referral_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  referrers      referrers?      @relation(fields: [referrer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rewards        rewards[]

  @@unique([merchant_id, order_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model referrers {
  id                    String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  merchant_id           String?                 @db.Uuid
  email                 String?                 @db.VarChar(255)
  phone                 String?                 @db.VarChar(50)
  name                  String?                 @db.VarChar(255)
  shopify_customer_id   String?                 @db.VarChar(255)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  referral_codes        referral_codes[]
  referral_transactions referral_transactions[]
  merchants             merchants?              @relation(fields: [merchant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([merchant_id, email])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rewards {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  merchant_id           String?                @db.Uuid
  transaction_id        String?                @db.Uuid
  campaign_id           String?                @db.Uuid
  user_email            String                 @db.VarChar(255)
  user_type             String                 @db.VarChar(20)
  reward_type           String                 @db.VarChar(50)
  amount                Decimal                @db.Decimal(10, 2)
  currency              String?                @default("INR") @db.VarChar(10)
  point_value           Int?
  status                String?                @default("pending") @db.VarChar(50)
  discount_code         String?                @db.VarChar(100)
  shopify_price_rule_id String?                @db.VarChar(255)
  approval_date         DateTime?              @db.Timestamptz(6)
  expiry_date           DateTime?              @db.Timestamptz(6)
  issued_at             DateTime?              @db.Timestamptz(6)
  created_at            DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?              @default(now()) @db.Timestamptz(6)
  campaigns             campaigns?             @relation(fields: [campaign_id], references: [id], onUpdate: NoAction)
  merchants             merchants?             @relation(fields: [merchant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  referral_transactions referral_transactions? @relation(fields: [transaction_id], references: [id], onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_points {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  merchant_id String?    @db.Uuid
  user_email  String     @db.VarChar(255)
  balance     Int?       @default(0)
  updated_at  DateTime?  @default(now()) @db.Timestamptz(6)
  merchants   merchants? @relation(fields: [merchant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([merchant_id, user_email])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_wallets {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  merchant_id String?    @db.Uuid
  user_email  String     @db.VarChar(255)
  balance     Decimal?   @default(0.00) @db.Decimal(10, 2)
  currency    String?    @default("INR") @db.VarChar(10)
  updated_at  DateTime?  @default(now()) @db.Timestamptz(6)
  merchants   merchants? @relation(fields: [merchant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([merchant_id, user_email])
}

enum WebhookStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

enum Role {
  ADMIN
  AFFILIATE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum ReferralStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversionType {
  SIGNUP
  PURCHASE
  TRIAL
  LEAD
}

enum ConversionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum PayoutMethod {
  PAYPAL
  BANK_TRANSFER
  STRIPE
  WISE
  BANK_CSV
  STRIPE_CONNECT
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CommissionRuleType {
  PERCENTAGE
  FIXED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum EmailTemplateType {
  WELCOME_EMAIL
  FIRST_REFERRAL
  NEW_REFERRAL
  PARTNER_PAID
  PARTNER_INVITATION
  PARTNER_APPROVAL
  PARTNER_DECLINED
  COMMISSION_APPROVED
  PAYOUT_GENERATED
  REFERRAL_CONVERTED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}
